{
	"name": "companion-module-dmxcore-dmxcore100",
	"version": "1.0.1",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "tsc -p tsconfig.test.json --pretty false && node --test 'dist-test/*.test.js'",
		"mock": "node scripts/mock-dmxcore-api.mjs"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-dmxcore-dmxcore100.git"
	},
	"engines": {
		"node": "^26.5",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.1.3",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^26.4.1",
		"@types/ws": "^8.18.1",
		"eslint": "^10.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.69.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.0"
}
